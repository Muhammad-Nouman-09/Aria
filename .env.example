# ===== Required (LLM via OpenRouter, OpenAI-compatible) =====
OPENROUTER_API_KEY=your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on the OpenRouter dashboard
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ARIA

# Free, tool-capable model. Swap for any ":free" model that supports tools,
# e.g. qwen/qwen3-coder:free, meta-llama/llama-3.3-70b-instruct:free
ARIA_MODEL=openai/gpt-oss-120b:free
MAX_TOKENS=4096

# Optional: only needed if you switch back to Anthropic directly
ANTHROPIC_API_KEY=

# ===== Voice (Phase 4) =====
WAKE_WORD=hey aria
# Whisper size: tiny | base | small | medium | large-v3 (bigger = slower/accurate)
WHISPER_MODEL=base
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
VOICE_ENABLED=false
# openwakeword pretrained model (hey_jarvis | alexa | hey_mycroft) or a custom
# .onnx/.tflite path. "hey aria" needs a custom-trained model.
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# ===== Permissions =====
ALLOW_SHELL_COMMANDS=true
REQUIRE_APPROVAL_FOR_SHELL=true
REQUIRE_APPROVAL_FOR_FILE_WRITE=true
REQUIRE_APPROVAL_FOR_DELETE=true
ALLOWED_DIRECTORIES=C:\Users\Nouman\Documents,C:\Users\Nouman\Desktop
BLOCKED_DIRECTORIES=C:\Windows,C:\Program Files,C:\Program Files (x86)

# ===== Web =====
WEB_SEARCH_ENABLED=true
SCRAPING_ENABLED=true
MAX_SEARCH_RESULTS=5

# ===== Memory =====
CONVERSATION_HISTORY_LIMIT=50
SEMANTIC_MEMORY_ENABLED=true

# ===== UI (Phase 5) =====
HOTKEY=ctrl+shift+a
STARTUP_WITH_WINDOWS=false
MINIMIZE_TO_TRAY=true

# ===== Scheduling (Phase 6) =====
REMINDER_CHECK_INTERVAL_SECONDS=30

# ===== Email (Phase 7, optional) =====
# Use an app password (Gmail/Outlook), not your main password.
EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=465
